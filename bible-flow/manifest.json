{
  "manifest_version": 3,
  "name": "Bible Flow",
  "version": "2.2.0",
  "description": "Hindi & English Bible verse lookup with dropdown selector",
  "permissions": [
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://bolls.life/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["bible.json", "english-bible.json"],
      "matches": ["<all_urls>"]
    }
  ]
}